---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { getCopy, getThoughtSlug } from '../utils/i18n';

const locale = 'zh-cn';
const copy = getCopy(locale);
const alternatePath = '/en/thinking/';
const posts = (await getCollection('thoughts', ({ data }) => data.lang === locale)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
const formatDate = (date: Date) => date.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
---

<Layout
  title={`${copy.thinking.title} | ${copy.brand.name}`}
  description={copy.seo.description}
  lang={locale}
  canonicalPath="/thinking/"
  alternatePath={alternatePath}
>
  <main class="site-shell reading-shell">
    <SiteHeader locale={locale} alternatePath={alternatePath} />

    <section class="reading-hero" data-reveal>
      <p class="soft-label">{copy.thinking.kicker}</p>
      <h1>{copy.thinking.title}</h1>
      {copy.thinking.intro && <p>{copy.thinking.intro}</p>}
      <div class="hero-material-stack" aria-hidden="true">
        <span class="hero-symbol hero-symbol-primary">
          <svg viewBox="0 0 28 28" role="presentation">
            <path d="M8.2 20.8 7 24.5l3.7-1.2L22 12a2.6 2.6 0 0 0-3.7-3.7L7 19.6Z" />
            <path d="m16.8 9.8 3.4 3.4M13 24h8.5" />
          </svg>
        </span>
        <span class="hero-symbol">
          <svg viewBox="0 0 28 28" role="presentation">
            <path d="M7 8.2h14M7 14h14M7 19.8h9" />
          </svg>
        </span>
        <span class="hero-symbol">{posts.length}</span>
        <span class="hero-slab hero-slab-a"></span>
        <span class="hero-slab hero-slab-b"></span>
      </div>
    </section>

    {posts.length > 0 ? (
      <section class="thought-list" aria-label="随笔列表">
        {posts.map((post) => (
          <a class="thought-card block" href={`/thinking/${getThoughtSlug(post)}/`} data-reveal>
            <span>{formatDate(post.data.publishedAt)} · {post.data.readingTime}</span>
            <strong>{post.data.title}</strong>
            <p>{post.data.excerpt}</p>
          </a>
        ))}
      </section>
    ) : (
      <section class="raw-empty" data-reveal>
        <h2>{copy.thinking.emptyTitle}</h2>
        <p>{copy.thinking.emptyDescription}</p>
      </section>
    )}
  </main>
</Layout>
