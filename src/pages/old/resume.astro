---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { getCopy } from '../../utils/i18n';

const locale = 'zh-cn';
const copy = getCopy(locale);
const alternatePath = '/old/en/resume/';
---

<Layout
    title={`${copy.nav.find((i) => i.id === 'resume')?.label || 'resume'} | ${copy.brand.name}`}
    description={copy.seo.description}
    lang={locale}
    canonicalPath="/old/resume/"
    alternatePath={alternatePath}
>
    <main class="site-shell">
        <SiteHeader locale={locale} alternatePath={alternatePath} basePath="/old" />

        <section id="resume" class="mx-auto mt-10 w-full max-w-6xl" data-reveal>
            <div class="rounded-[2.5rem] bg-gradient-to-br from-white/90 to-white/50 backdrop-blur-3xl border border-white shadow-xl px-8 py-14 text-[#1d1d1f] sm:px-12 sm:py-20 relative overflow-hidden transition-all duration-700 hover:shadow-2xl">
                <p class="soft-label mb-5">{copy.resume.kicker}</p>
                <h1 class="hero-title max-w-4xl font-semibold">{copy['resume']?.title || 'resume'}</h1>
                <p class="mt-5 max-w-3xl text-[17px] leading-[1.47] text-[#1d1d1f]/70">{copy['resume']?.intro || ''}</p>
                <div class="mt-8 flex flex-wrap gap-2">
                    <span class="inline-flex items-center rounded-full border border-black/10 bg-white/60 backdrop-blur-md px-4 py-1.5 text-[12px] text-[#1d1d1f]">视觉算法主线</span>
                    <span class="inline-flex items-center rounded-full border border-black/10 bg-white/60 backdrop-blur-md px-4 py-1.5 text-[12px] text-[#1d1d1f]">工程与研究并行</span>
                    <span class="inline-flex items-center rounded-full border border-black/10 bg-white/60 backdrop-blur-md px-4 py-1.5 text-[12px] text-[#1d1d1f]">跨学科训练</span>
                </div>
            </div>
        </section>

        <section class="mx-auto mb-24 mt-6 w-full max-w-6xl" data-reveal>
            <div class="rounded-xl bg-[#f5f5f7] p-8 sm:p-12">
                <h2 class="section-title">简历结构</h2>
                <div class="mt-8 border-t border-black/12">
                    <article class="data-row md:grid-cols-[1fr_2fr]">
                        <div class="font-semibold text-[#1d1d1f]">教育底座</div>
                        <div>浙江大学农业工程专业，建立工程问题理解与系统化分析能力。</div>
                    </article>
                    <article class="data-row md:grid-cols-[1fr_2fr]">
                        <div class="font-semibold text-[#1d1d1f]">研究主线</div>
                        <div>以图像融合与视觉算法为核心方向，逐步走向可验证的研究与工程成果。</div>
                    </article>
                    <article class="data-row md:grid-cols-[1fr_2fr]">
                        <div class="font-semibold text-[#1d1d1f]">交叉扩展</div>
                        <div>通过科技创业投资与金融训练补足技术落地、商业理解和长期策略视角。</div>
                    </article>
                </div>
            </div>
        </section>

        <section class="mx-auto mb-24 mt-6 w-full max-w-6xl" data-reveal>
            <div class="rounded-xl bg-[#f5f5f7] p-8 sm:p-12">
                <h2 class="section-title">{copy.resume.projectsTitle}</h2>
                <p class="mt-3 text-[#1d1d1f]/70">{copy.resume.projectsIntro}</p>
                <div class="mt-8 border-t border-black/12">
                    <article class="data-row md:grid-cols-[1fr_2fr]">
                        <div class="font-semibold text-[#1d1d1f]">{copy.resume.projectsEmptyTitle}</div>
                        <div>{copy.resume.projectsEmptyDescription}</div>
                    </article>
                </div>
            </div>
        </section>
    </main>
</Layout>