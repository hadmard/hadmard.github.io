---
import Layout from '../../../layouts/Layout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import { getCopy } from '../../../utils/i18n';

const locale = 'en';
const copy = getCopy(locale);
const alternatePath = "/old/thinking/";
---

<Layout
  title={`${copy.thinking.title} | ${copy.brand.name}`}
  description={copy.seo.description}
  lang={locale}
  canonicalPath="/old/en/thinking/"
  alternatePath={alternatePath}
>
  <main class="site-shell">
    <SiteHeader locale={locale} alternatePath={alternatePath} basePath="/old" />

    <section class="feature-hero mx-auto mt-10 w-full max-w-6xl" data-reveal>
      <div class="feature-hero-copy">
        <p class="soft-label mb-5">{copy.thinking.kicker}</p>
        <h1 class="hero-title max-w-4xl font-semibold">{copy.thinking.title}</h1>
        <p class="mt-5 max-w-3xl text-[17px] leading-[1.55] text-[#1d1d1f]/70">
          {copy.thinking.intro}
        </p>
      </div>
      <div class="feature-hero-panel">
        <div class="feature-stat">
          <span>Format</span>
          <strong>Notes</strong>
          <p>Future posts can hold stage reviews, research judgments, and cognitive notes.</p>
        </div>
        <div class="feature-stat">
          <span>Status</span>
          <strong>Ready</strong>
          <p>The page structure is ready for the first real essays.</p>
        </div>
      </div>
    </section>

    <section class="mx-auto mb-24 mt-6 w-full max-w-6xl" data-reveal>
      <div class="analysis-panel p-8 sm:p-12">
        <p class="section-kicker">Editorial Queue</p>
        <h2 class="section-title mt-3">{copy.thinking.emptyTitle}</h2>
        <p class="mt-5 max-w-2xl text-[15px] leading-8 text-[#1d1d1f]/64">{copy.thinking.emptyDescription}</p>
        <div class="mt-8 grid gap-3 sm:grid-cols-3">
          <article class="snapshot-card">
            <p>01</p>
            <strong>Research reviews</strong>
            <span>Algorithm learning, experiment logs, and stage judgments.</span>
          </article>
          <article class="snapshot-card">
            <p>02</p>
            <strong>Investment memo</strong>
            <span>Turning trading logs into rules and operating discipline.</span>
          </article>
          <article class="snapshot-card">
            <p>03</p>
            <strong>Long questions</strong>
            <span>Questions that remain worth revisiting even before they are solved.</span>
          </article>
        </div>
      </div>
    </section>
  </main>
</Layout>
