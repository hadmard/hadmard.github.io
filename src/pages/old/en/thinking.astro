---
import Layout from '../../../layouts/Layout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import { getCopy } from '../../../utils/i18n';

const locale = 'en';
const copy = getCopy(locale);
const alternatePath = '/old/thinking/';
---

<Layout
  title={`${copy.thinking.title} | ${copy.brand.name}`}
  description={copy.seo.description}
  lang={locale}
  canonicalPath="/old/en/thinking/"
  alternatePath={alternatePath}
>
  <main class="site-shell reading-shell">
    <SiteHeader locale={locale} alternatePath={alternatePath} basePath="/old" />

    <section class="reading-hero" data-reveal>
      <p class="soft-label">{copy.thinking.kicker}</p>
      <h1>{copy.thinking.title}</h1>
      <p>{copy.thinking.intro}</p>
    </section>

    <section class="raw-empty" data-reveal>
      <h2>{copy.thinking.emptyTitle}</h2>
      <p>{copy.thinking.emptyDescription}</p>
    </section>
  </main>
</Layout>
