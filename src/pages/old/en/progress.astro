---
import Layout from '../../../layouts/Layout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import LearningMap from '../../../components/LearningMap';
import { getCopy } from '../../../utils/i18n';

const locale = 'en';
const copy = getCopy(locale);
const alternatePath = "/old/progress/";
---

<Layout
  title={`${copy.progress.title} | ${copy.brand.name}`}
  description={copy.seo.description}
  lang={locale}
  canonicalPath="/old/en/progress/"
  alternatePath={alternatePath}
>
  <main class="site-shell">
    <SiteHeader locale={locale} alternatePath={alternatePath} basePath="/old" />

    <section class="feature-hero mx-auto mt-10 w-full max-w-6xl" data-reveal>
      <div class="feature-hero-copy">
        <p class="soft-label mb-5">{copy.progress.kicker}</p>
        <h1 class="hero-title max-w-4xl font-semibold">{copy.progress.title}</h1>
        <p class="mt-5 max-w-3xl text-[17px] leading-[1.55] text-[#1d1d1f]/70">
          {copy.progress.intro}
        </p>
      </div>
      <div class="feature-hero-panel">
        <div class="feature-stat">
          <span>Active</span>
          <strong>3</strong>
          <p>Calculus, linear algebra, and CS61A are moving together.</p>
        </div>
        <div class="feature-stat">
          <span>Next</span>
          <strong>CV</strong>
          <p>The path ultimately points to visual algorithms and robotic systems.</p>
        </div>
      </div>
    </section>

    <section class="map-stage mx-auto mb-14 mt-6 w-full max-w-6xl" data-reveal>
      <div class="mb-5 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <p class="section-kicker">Capability Map</p>
          <h2 class="section-title mt-3">A route from scattered courses to usable capability.</h2>
        </div>
        <p class="max-w-md text-[14px] leading-7 text-[#1d1d1f]/62">
          The map is now treated as the page's core product surface: click a node to inspect its reason, prerequisites, and current state.
        </p>
      </div>
      <div class="relative w-full">
        <LearningMap client:load />
      </div>
    </section>

    <section class="mx-auto mb-24 w-full max-w-6xl" data-reveal>
      <div class="analysis-panel p-8 sm:p-12">
        <p class="section-kicker">Internship Goal</p>
        <h2 class="section-title mt-3">Internship target at progression convergence</h2>

        <div class="mt-8 border-t border-black/12">
          <article class="data-row md:grid-cols-[1.2fr_2fr]">
            <div class="font-semibold text-[#1d1d1f]">Foundation Layer (Sequential)</div>
            <div>Math, programming, and systems fundamentals build the prerequisite depth for later stages.</div>
          </article>
          <article class="data-row md:grid-cols-[1.2fr_2fr]">
            <div class="font-semibold text-[#1d1d1f]">Specialized Layer (Parallel)</div>
            <div>Algorithms, systems, and model capabilities advance in parallel and are combined downstream.</div>
          </article>
          <article class="data-row md:grid-cols-[1.2fr_2fr]">
            <div class="font-semibold text-[#1d1d1f]">Research Internship Convergence Goal</div>
            <div>Google / Meta / Jane Street and other top international internships as the final target.</div>
          </article>
        </div>
      </div>
    </section>
  </main>
</Layout>
