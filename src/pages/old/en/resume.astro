---
import Layout from '../../../layouts/Layout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import { getCopy } from '../../../utils/i18n';

const locale = 'en';
const copy = getCopy(locale);
const alternatePath = "/old/resume/";
---

<Layout
    title={`${copy.nav.find((i) => i.id === 'resume')?.label || 'resume'} | ${copy.brand.name}`}
    description={copy.seo.description}
    lang={locale}
    canonicalPath="/old/en/resume/"
    alternatePath={alternatePath}
>
    <main class="site-shell">
        <SiteHeader locale={locale} alternatePath={alternatePath} basePath="/old" />

        <section id="resume" class="feature-hero mx-auto mt-10 w-full max-w-6xl" data-reveal>
            <div class="feature-hero-copy">
                <p class="soft-label mb-5">{copy.resume.kicker}</p>
                <h1 class="hero-title max-w-4xl font-semibold">{copy.resume.title}</h1>
                <p class="mt-5 max-w-3xl text-[17px] leading-[1.55] text-[#1d1d1f]/70">{copy.resume.intro}</p>
                <div class="mt-8 flex flex-wrap gap-2">
                    {copy.resume.capsules.map((item) => <span class="signal-pill">{item}</span>)}
                </div>
            </div>
            <div class="feature-hero-panel">
                <div class="feature-stat">
                    <span>Direction</span>
                    <strong>CV</strong>
                    <p>Visual algorithms and image fusion are the current center.</p>
                </div>
                <div class="feature-stat">
                    <span>Layer</span>
                    <strong>AI+X</strong>
                    <p>Engineering training extended by finance and venture thinking.</p>
                </div>
            </div>
        </section>

        <section class="mx-auto mb-24 mt-6 w-full max-w-6xl" data-reveal>
            <div class="analysis-panel p-8 sm:p-12">
                <h2 class="section-title">Resume Structure</h2>
                <div class="mt-8 border-t border-black/12">
                    {copy.resume.timeline.map((item) => (
                        <article class="data-row md:grid-cols-[1fr_1.35fr_2fr]">
                            <div class="font-semibold text-[#0071e3]">{item.period}</div>
                            <div class="font-semibold text-[#1d1d1f]">{item.title}</div>
                            <div>{item.description}</div>
                        </article>
                    ))}
                </div>
            </div>
        </section>

        <section class="mx-auto mb-24 mt-6 w-full max-w-6xl" data-reveal>
            <div class="analysis-panel p-8 sm:p-12">
                <h2 class="section-title">{copy.resume.projectsTitle}</h2>
                <p class="mt-3 text-[#1d1d1f]/70">{copy.resume.projectsIntro}</p>
                <div class="mt-8 border-t border-black/12">
                    <article class="data-row md:grid-cols-[1fr_2fr]">
                        <div class="font-semibold text-[#1d1d1f]">{copy.resume.projectsEmptyTitle}</div>
                        <div>{copy.resume.projectsEmptyDescription}</div>
                    </article>
                </div>
            </div>
        </section>
    </main>
</Layout>
