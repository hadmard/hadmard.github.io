---
import { readFile } from 'node:fs/promises';
import { resolve } from 'node:path';
import Layout from '../../../layouts/Layout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import { getCopy } from '../../../utils/i18n';

const locale = 'en';
const copy = getCopy(locale);
const alternatePath = '/old/investments/';

type Cc98Post = {
	id: number;
	userName: string | null;
	content: string;
	time: string;
	floor: number;
	isDeleted: boolean;
	isLZ: boolean;
};

type PostPage = {
	items?: Cc98Post[];
};

type Summary = {
	sourceUrl?: string;
	topic?: {
		title?: string;
		authorName?: string;
		hitCount?: number;
	};
	crawledAt?: string;
};

const outputDir = resolve(process.cwd(), 'custom/cc98-investment-crawler/output/topic-6450962');

let summary: Summary | null = null;
let records: Cc98Post[] = [];

try {
	const [summaryRaw, postsRaw] = await Promise.all([
		readFile(resolve(outputDir, 'records/investment-summary.json'), 'utf-8'),
		readFile(resolve(outputDir, 'raw/posts.json'), 'utf-8'),
	]);

	summary = JSON.parse(summaryRaw) as Summary;
	const pages = JSON.parse(postsRaw) as PostPage[];
	const allPosts = pages.flatMap((page) => page.items ?? []);

	const cleanPosts = allPosts
		.filter((post) => !post.isDeleted && post.content?.trim())
		.sort((a, b) => a.floor - b.floor);

	const authorName = summary?.topic?.authorName;
	records = cleanPosts.filter((post) => post.isLZ || (authorName && post.userName === authorName));

	if (!records.length) {
		records = cleanPosts;
	}
} catch {
	summary = null;
	records = [];
}

const formatDate = (value: string) => new Date(value).toLocaleString('en-US', {
	month: '2-digit',
	day: '2-digit',
	hour: '2-digit',
	minute: '2-digit',
	hour12: false,
});

const cleanText = (content: string) => content
	.replace(/\[img\][\s\S]*?\[\/img\]/gi, '\n')
	.replace(/\[[^\]\n]{1,80}\]/g, '')
	.replace(/\p{Extended_Pictographic}/gu, '')
	.replace(/[\uFE0F\u200D]/g, '')
	.replace(/\r\n?/g, '\n')
	.split('\n')
	.map((line) => line.replace(/[ \t]+/g, ' ').trim())
	.join('\n')
	.replace(/\n{3,}/g, '\n\n')
	.trim();

const placeholderTexts = new Set(['记录投资日常', 'test']);
const visibleRecords = records
	.map((record) => ({
		...record,
		cleanContent: cleanText(record.content),
	}))
	.filter((record) => record.cleanContent && !placeholderTexts.has(record.cleanContent));

const crawledAtText = summary?.crawledAt
	? new Date(summary.crawledAt).toLocaleString('en-US', { hour12: false })
	: null;
---

<Layout
	title={`${copy.investments.title} | ${copy.brand.name}`}
	description={copy.seo.description}
	lang={locale}
	canonicalPath="/old/en/investments/"
	alternatePath={alternatePath}
>
	<main class="site-shell reading-shell">
		<SiteHeader locale={locale} alternatePath={alternatePath} basePath="/old" />

		<section class="reading-hero" data-reveal>
			<p class="soft-label">{copy.investments.kicker}</p>
			<h1>{copy.investments.title}</h1>
			<p>{copy.investments.intro}</p>
			<div class="reading-meta">
				{summary?.topic?.title && <span>{summary.topic.title}</span>}
				<span>{visibleRecords.length} entries</span>
				{summary?.sourceUrl && (
					<a href={summary.sourceUrl} target="_blank" rel="noopener noreferrer">source</a>
				)}
				{crawledAtText && <span>{crawledAtText}</span>}
			</div>
		</section>

		{visibleRecords.length > 0 ? (
			<section class="raw-log" aria-label="Raw investment records">
				{visibleRecords.map((record) => (
					<article class="raw-entry">
						<div class="raw-entry-meta">
							<span>#{record.floor}</span>
							<time>{formatDate(record.time)}</time>
						</div>
						<div class="raw-entry-body">
							{record.cleanContent.split(/\n{2,}/).map((paragraph) => (
								<p>{paragraph}</p>
							))}
						</div>
					</article>
				))}
			</section>
		) : (
			<section class="raw-empty" data-reveal>
				<h2>{copy.investments.emptyTitle}</h2>
				<p>{copy.investments.emptyDescription}</p>
			</section>
		)}
	</main>
</Layout>
