---
// 文件说明：该文件是站点根首页。
// 功能说明：让 hadmard.github.io 回到老站首页内容，具体栏目继续复用 /old/ 下的既有页面。
//
// 结构概览：
//   第一部分：加载中文文章
//   第二部分：渲染共享首页组件
import { getCollection } from 'astro:content';

import HomePage from '../components/HomePage.astro';

const thoughts = (await getCollection('thoughts', ({ data }) => data.lang === 'zh-cn')).sort(
	(a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
---

<HomePage locale="zh-cn" thoughts={thoughts} basePath="" navBasePath="/old" canonicalPath="/" alternatePath="/old/en/" />
