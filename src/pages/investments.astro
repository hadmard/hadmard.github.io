---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ReadingAssist from '../components/ReadingAssist.astro';
import { getCopy } from '../utils/i18n';
import { loadCc98Dataset } from '../utils/cc98';
import { createFloorOutline } from '../utils/reading';

const locale = 'zh-cn';
const copy = getCopy(locale);
const alternatePath = '/en/investments/';

const { config, summary, visibleRecords } = await loadCc98Dataset('investments');

const formatDay = (value: string) => new Date(value).toLocaleDateString('zh-CN', {
	month: '2-digit',
	day: '2-digit',
});
const formatTime = (value: string) => new Date(value).toLocaleTimeString('zh-CN', {
	hour: '2-digit',
	minute: '2-digit',
	hour12: false,
});

const outline = createFloorOutline(visibleRecords, locale);

const crawledAtText = summary?.crawledAt
	? new Date(summary.crawledAt).toLocaleString('zh-CN', { hour12: false })
	: null;
const sourceUrl = summary?.sourceUrl ?? config.sourceUrl;
---

<Layout
	title={`${copy.investments.title} | ${copy.brand.name}`}
	description={copy.seo.description}
	lang={locale}
	canonicalPath="/investments/"
	alternatePath={alternatePath}
>
	<main class="site-shell reading-shell">
		<SiteHeader locale={locale} alternatePath={alternatePath} />

		<section class="reading-hero investment-hero" data-reveal>
			<p class="soft-label">{copy.investments.kicker}</p>
			<h1>{copy.investments.title}</h1>
			{copy.investments.intro && <p>{copy.investments.intro}</p>}
			<div class="hero-material-stack investment-symbol-stack" aria-hidden="true">
				<span class="hero-symbol hero-symbol-primary">¥</span>
				<span class="hero-symbol">
					<svg viewBox="0 0 28 28" role="presentation">
						<path d="M5 22.5h18M7 20.2l5.1-5.4 3.9 3.5 6-8.6" />
						<path d="M18.2 9.7H22v3.8" />
					</svg>
				</span>
				<span class="hero-symbol">{visibleRecords.length}</span>
				<span class="hero-slab hero-slab-a"></span>
				<span class="hero-slab hero-slab-b"></span>
				<span class="market-orbit market-orbit-a">
					<svg viewBox="0 0 72 36" role="presentation">
						<path d="M5 26 C13 9 22 30 31 18 S47 7 55 15 62 24 67 8" />
					</svg>
				</span>
			</div>
			<div class="reading-meta">
				{summary?.topic?.title && <span>{summary.topic.title}</span>}
				<span>{visibleRecords.length} 条</span>
				{sourceUrl && (
					<a href={sourceUrl} target="_blank" rel="noopener noreferrer">原帖</a>
				)}
				{crawledAtText && <span>{crawledAtText}</span>}
			</div>
		</section>

		<ReadingAssist outline={outline} label="楼层目录" />

		{visibleRecords.length > 0 ? (
			<section class="raw-log investment-log" aria-label="投资记录原文">
				{visibleRecords.map((record, index) => (
					<article id={`floor-${record.floor}`} class="raw-entry investment-entry" data-reveal style={`--entry-index: ${index}`}>
						<span class="investment-node" aria-hidden="true">
							<svg viewBox="0 0 28 28" role="presentation">
								<path d="M6 20.5h16M8 18l4.4-4.9 3.8 3 5.8-8.2" />
								<path d="M18.4 7.9H22v3.6" />
							</svg>
						</span>
						<div class="investment-entry-head">
							<div class="raw-entry-meta investment-meta">
								<span class="meta-chip investment-day">
									<svg viewBox="0 0 20 20" role="presentation">
										<path d="M5.2 3.8v2.8M14.8 3.8v2.8M3.8 7.5h12.4M5.5 5h9a2 2 0 0 1 2 2v7.5a2 2 0 0 1-2 2h-9a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z" />
									</svg>
									{formatDay(record.time)}
								</span>
								<time class="meta-chip">
									<svg viewBox="0 0 20 20" role="presentation">
										<path d="M10 4.2a5.8 5.8 0 1 1 0 11.6 5.8 5.8 0 0 1 0-11.6Z" />
										<path d="M10 7.2v3.2l2.2 1.4" />
									</svg>
									{formatTime(record.time)}
								</time>
								<span class="meta-chip meta-chip-floor">
									<svg viewBox="0 0 20 20" role="presentation">
										<path d="M6 4.5h7.8a1.7 1.7 0 0 1 1.7 1.7v9.3H7.2A2.2 2.2 0 0 1 5 13.3V5.5a1 1 0 0 1 1-1Z" />
										<path d="M7.2 15.5a2.2 2.2 0 0 1 0-4.4h8.3M8 7.4h4.8" />
									</svg>
									#{record.floor}
								</span>
								<span class="meta-chip meta-chip-user">
									<svg viewBox="0 0 20 20" role="presentation">
										<path d="M10 10.1a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4Z" />
										<path d="M4.4 16.3a5.9 5.9 0 0 1 11.2 0" />
									</svg>
									{record.userName ?? config.ownerName}
								</span>
							</div>
							<span class="investment-glyph" aria-hidden="true">
								<svg viewBox="0 0 36 36" role="presentation">
									<path d="M7 27h22M10 24V13M18 24V8M26 24V16" />
									<path d="M8 18h4M16 12h4M24 20h4" />
								</svg>
							</span>
						</div>
						<div class="raw-entry-body markdown-body" set:html={record.renderedContent} />
					</article>
				))}
			</section>
		) : (
			<section class="raw-empty" data-reveal>
				<h2>{copy.investments.emptyTitle}</h2>
				<p>{copy.investments.emptyDescription}</p>
			</section>
		)}
	</main>
</Layout>
