---
// 文件说明：该文件是全站通用布局。
// 功能说明：统一处理 SEO 元信息、全局样式、视图切换与页面外层结构。
//
// 结构概览：
//   第一部分：导入依赖与解析页面参数
//   第二部分：生成 canonical 与 alternate 元信息
//   第三部分：输出页面框架
import '../styles/global.css';

import { ClientRouter } from 'astro:transitions';

interface Props {
	title: string;
	description: string;
	lang: string;
	canonicalPath: string;
	alternatePath?: string;
}

const { title, description, lang, canonicalPath, alternatePath } = Astro.props;
const canonical = Astro.site ? new URL(canonicalPath, Astro.site).toString() : undefined;
const alternate = alternatePath && Astro.site ? new URL(alternatePath, Astro.site).toString() : undefined;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#f8fafc" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
		{canonical && <link rel="canonical" href={canonical} />}
		{alternate && <link rel="alternate" hreflang={lang === 'zh-cn' ? 'en' : 'zh-CN'} href={alternate} />}
		<title>{title}</title>
		<ClientRouter />
	</head>
	<body>
		<slot />
		<script is:inline>
			const setupReveal = () => {
				const items = document.querySelectorAll('[data-reveal]');
				if (!items.length) return;

				items.forEach((item, index) => {
					if (item instanceof HTMLElement) {
						item.style.setProperty('--reveal-index', String(Math.min(index, 6)));
					}
				});

				const observer = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (entry.isIntersecting) {
								entry.target.classList.add('is-visible');
								observer.unobserve(entry.target);
							}
						}
					},
					{ threshold: 0.18, rootMargin: '0px 0px -8% 0px' },
				);

				for (const item of items) {
					observer.observe(item);
				}
			};

			const setupMaterialMotion = () => {
				if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

				const roots = document.querySelectorAll(
					'.blog-hero, .reading-hero, .article-hero, .blog-card, .thought-card, .raw-entry, .raw-empty',
				);

				for (const root of roots) {
					if (!(root instanceof HTMLElement) || root.dataset.motionReady === 'true') continue;
					root.dataset.motionReady = 'true';

					const children = root.querySelectorAll('.material-layer, .hero-symbol, .hero-slab, .blog-card i');
					let frame = 0;
					let nextX = 0;
					let nextY = 0;

					const applyMotion = () => {
						frame = 0;
						root.style.setProperty('--spotlight-x', `${50 + nextX * 34}%`);
						root.style.setProperty('--spotlight-y', `${48 + nextY * 28}%`);

						children.forEach((child, index) => {
							if (!(child instanceof HTMLElement)) return;
							const depth = Number.parseFloat(getComputedStyle(child).getPropertyValue('--motion-depth')) || (index + 1) * 7;
							child.style.setProperty('--parallax-x', `${nextX * depth}px`);
							child.style.setProperty('--parallax-y', `${nextY * depth * 0.72}px`);
							child.style.setProperty('--parallax-rx', `${nextY * -2.6}deg`);
							child.style.setProperty('--parallax-ry', `${nextX * 3.4}deg`);
						});
					};

					const schedule = (event) => {
						const rect = root.getBoundingClientRect();
						nextX = ((event.clientX - rect.left) / rect.width - 0.5) * 2;
						nextY = ((event.clientY - rect.top) / rect.height - 0.5) * 2;
						if (!frame) frame = window.requestAnimationFrame(applyMotion);
					};

					const reset = () => {
						nextX = 0;
						nextY = 0;
						if (!frame) frame = window.requestAnimationFrame(applyMotion);
					};

					root.addEventListener('pointermove', schedule);
					root.addEventListener('pointerleave', reset);
				}
			};

			document.addEventListener('astro:page-load', setupReveal);
			document.addEventListener('astro:page-load', setupMaterialMotion);
			document.addEventListener('DOMContentLoaded', setupReveal);
			document.addEventListener('DOMContentLoaded', setupMaterialMotion);
		</script>
	</body>
</html>
