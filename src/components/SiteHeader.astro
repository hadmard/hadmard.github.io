---
import { getCopy } from '../utils/i18n';
import LocaleSwitch from './LocaleSwitch.astro';
const { locale, alternatePath, basePath = '' } = Astro.props;
const copy = getCopy(locale);
const normalizedBasePath = basePath ? `/${basePath.replace(/^\/+|\/+$/g, '')}` : '';
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const homeHref = locale === 'zh-cn' ? `${normalizedBasePath || '/'}` : `${normalizedBasePath}/en/`;
const normalizedHomePath = homeHref.replace(/\/$/, '') || '/';
const homeLabel = locale === 'zh-cn' ? '首页' : 'Home';

const getHref = (id: string) => {
    return locale === 'zh-cn' ? `${normalizedBasePath}/${id}/` : `${normalizedBasePath}/en/${id}/`;
};
---

<header class="glass-topbar flex flex-wrap items-center justify-between gap-4 mb-4">
    <a class="brand-lockup" href={homeHref} aria-label={homeLabel}>
        <p class="text-[15px] font-semibold text-[#1d1d1f]">{copy.brand.name}</p>
    </a>
    <div class="flex flex-wrap items-center gap-2 sm:gap-4">
        <nav class="flex flex-wrap items-center gap-1"> 
            <a
                class={currentPath === normalizedHomePath ? 'nav-link active' : 'nav-link'}
                href={homeHref}
                aria-current={currentPath === normalizedHomePath ? 'page' : undefined}
            >
                {homeLabel}
            </a>
            {
                copy.nav.map((item) => {
                    const targetPath = getHref(item.id).replace(/\/$/, '');
                    const isActive = currentPath === targetPath || currentPath.startsWith(`${targetPath}/`);
                    
                    return (
                        <a 
                            class={isActive ? 'nav-link active' : 'nav-link'} 
                            href={getHref(item.id)}
                            aria-current={isActive ? 'page' : undefined}
                        >
                            {item.label}
                        </a>
                    );
                })
            }
        </nav>
        <LocaleSwitch currentLocale={locale} href={alternatePath} />
    </div>
</header>

<script>
	const centerActiveNavigation = () => {
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		document.querySelectorAll('.glass-topbar nav').forEach((nav) => {
			if (!(nav instanceof HTMLElement)) return;

			const activeLink = nav.querySelector('.nav-link.active');
			if (!(activeLink instanceof HTMLElement)) return;
			if (nav.scrollWidth <= nav.clientWidth) return;

			const nextLeft = activeLink.offsetLeft - nav.clientWidth / 2 + activeLink.offsetWidth / 2;
			nav.scrollTo({
				left: Math.max(0, nextLeft),
				behavior: reduceMotion ? 'auto' : 'smooth',
			});
		});
	};

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', centerActiveNavigation, { once: true });
	} else {
		requestAnimationFrame(centerActiveNavigation);
	}

	window.addEventListener('pageshow', centerActiveNavigation);
</script>
