---
// 文件说明：渲染阅读进度条与文章大纲。
// 功能说明：用同一套轻量交互服务 Markdown 文章和 CC98 楼层时间线。
import type { ReadingOutlineItem } from '../utils/reading';

const { outline = [], label = '目录' } = Astro.props as {
	outline?: ReadingOutlineItem[];
	label?: string;
};

const visibleOutline = outline.filter((item) => item.id && item.label);
---

<div class="reading-progress-rail" aria-hidden="true">
	<span class="reading-progress-fill" data-reading-progress-bar></span>
</div>

{visibleOutline.length > 0 && (
	<aside class="reading-outline" data-reading-outline aria-label={label}>
		<button class="reading-outline-head" type="button" data-reading-outline-toggle aria-expanded="true">
			<span class="reading-outline-icon" aria-hidden="true">
				<svg viewBox="0 0 28 28" role="presentation">
					<path d="M7.2 7.8h13.6M7.2 14h13.6M7.2 20.2h8.4" />
					<path d="M4.5 7.8h.1M4.5 14h.1M4.5 20.2h.1" />
				</svg>
			</span>
			<span class="reading-outline-title">{label}</span>
			<span class="reading-outline-grip" aria-hidden="true">
				<svg viewBox="0 0 20 20" role="presentation">
					<path d="M5.5 6.5h9M5.5 10h9M5.5 13.5h9" />
				</svg>
			</span>
			<span class="reading-outline-chevron" aria-hidden="true">
				<svg viewBox="0 0 20 20" role="presentation">
					<path d="m5.8 8 4.2 4.2L14.2 8" />
				</svg>
			</span>
		</button>
		<nav class="reading-outline-list" data-reading-outline-list>
			{visibleOutline.map((item) => (
				<a
					href={`#${item.id}`}
					class="reading-outline-link"
					data-outline-target={item.id}
					style={`--outline-depth: ${Math.max(0, item.level - 2)}`}
				>
					<span>{item.label}</span>
				</a>
			))}
		</nav>
	</aside>
)}

<script is:inline>
	const setupReadingAssist = () => {
		if (window.__readingAssistCleanup) window.__readingAssistCleanup();

		const progressBars = [...document.querySelectorAll('[data-reading-progress-bar]')];
		const outlines = [...document.querySelectorAll('[data-reading-outline]')];
		const outlineLinks = [...document.querySelectorAll('[data-outline-target]')];
		if (!progressBars.length && !outlineLinks.length && !outlines.length) return;

		let frame = 0;
		const cleanups = [];
		const on = (target, eventName, handler, options) => {
			target.addEventListener(eventName, handler, options);
			cleanups.push(() => target.removeEventListener(eventName, handler, options));
		};

		const readState = (key) => {
			try {
				return JSON.parse(window.localStorage.getItem(key) || '{}') || {};
			} catch {
				return {};
			}
		};

		const writeState = (key, state) => {
			try {
				window.localStorage.setItem(key, JSON.stringify(state));
			} catch {
				// localStorage can be unavailable in private contexts.
			}
		};

		const clampPosition = (outline, x, y) => {
			const margin = 12;
			const rect = outline.getBoundingClientRect();
			const width = rect.width || outline.offsetWidth || 220;
			const height = rect.height || outline.offsetHeight || 64;
			const maxX = Math.max(margin, window.innerWidth - width - margin);
			const maxY = Math.max(margin, window.innerHeight - height - margin);
			return {
				x: Math.min(maxX, Math.max(margin, x)),
				y: Math.min(maxY, Math.max(margin, y)),
			};
		};

		const applyPosition = (outline, x, y) => {
			const position = clampPosition(outline, x, y);
			outline.dataset.dragged = 'true';
			outline.style.left = `${Math.round(position.x)}px`;
			outline.style.top = `${Math.round(position.y)}px`;
			outline.style.right = 'auto';
			outline.style.bottom = 'auto';
			return position;
		};

		const setCollapsed = (outline, toggle, collapsed) => {
			outline.classList.toggle('is-collapsed', collapsed);
			toggle.setAttribute('aria-expanded', String(!collapsed));
		};

		const setupOutlinePanel = (outline, index) => {
			const toggle = outline.querySelector('[data-reading-outline-toggle]');
			if (!toggle) return;

			const stateKey = `reading-outline:${window.location.pathname}:${index}`;
			const savedState = readState(stateKey);
			const startsCollapsed =
				typeof savedState.collapsed === 'boolean'
					? savedState.collapsed
					: window.matchMedia('(max-width: 640px)').matches;
			setCollapsed(outline, toggle, startsCollapsed);

			if (Number.isFinite(savedState.x) && Number.isFinite(savedState.y)) {
				window.requestAnimationFrame(() => applyPosition(outline, savedState.x, savedState.y));
			}

			let dragState = null;
			let suppressClick = false;

			const persistCurrentState = () => {
				const rect = outline.getBoundingClientRect();
				const currentState = readState(stateKey);
				writeState(stateKey, {
					...currentState,
					collapsed: outline.classList.contains('is-collapsed'),
					...(outline.dataset.dragged === 'true'
						? { x: Math.round(rect.left), y: Math.round(rect.top) }
						: {}),
				});
			};

			on(toggle, 'pointerdown', (event) => {
				if (event.button !== undefined && event.button !== 0) return;
				const rect = outline.getBoundingClientRect();
				dragState = {
					id: event.pointerId,
					startX: event.clientX,
					startY: event.clientY,
					left: rect.left,
					top: rect.top,
					moved: false,
				};
				toggle.setPointerCapture?.(event.pointerId);
				outline.classList.add('is-dragging');
			});

			on(toggle, 'pointermove', (event) => {
				if (!dragState || dragState.id !== event.pointerId) return;
				const dx = event.clientX - dragState.startX;
				const dy = event.clientY - dragState.startY;
				if (!dragState.moved && Math.hypot(dx, dy) < 5) return;

				dragState.moved = true;
				event.preventDefault();
				applyPosition(outline, dragState.left + dx, dragState.top + dy);
			});

			const endDrag = (event) => {
				if (!dragState || dragState.id !== event.pointerId) return;
				outline.classList.remove('is-dragging');
				toggle.releasePointerCapture?.(event.pointerId);

				if (dragState.moved) {
					suppressClick = true;
					persistCurrentState();
					window.setTimeout(() => {
						suppressClick = false;
					}, 0);
				}

				dragState = null;
			};

			on(toggle, 'pointerup', endDrag);
			on(toggle, 'pointercancel', endDrag);

			on(toggle, 'click', (event) => {
				if (suppressClick) {
					event.preventDefault();
					return;
				}

				const collapsed = !outline.classList.contains('is-collapsed');
				setCollapsed(outline, toggle, collapsed);
				window.requestAnimationFrame(() => {
					if (outline.dataset.dragged === 'true') {
						const rect = outline.getBoundingClientRect();
						applyPosition(outline, rect.left, rect.top);
					}
					persistCurrentState();
				});
			});
		};

		outlines.forEach(setupOutlinePanel);

		const sections = outlineLinks
			.map((link) => ({
				link,
				target: document.getElementById(link.dataset.outlineTarget || ''),
			}))
			.filter((item) => item.target);

		const setActive = (activeId) => {
			for (const { link } of sections) {
				link.classList.toggle('is-active', link.dataset.outlineTarget === activeId);
			}
		};

		const update = () => {
			frame = 0;
			const root = document.documentElement;
			const scrollable = Math.max(1, root.scrollHeight - window.innerHeight);
			const progress = Math.min(1, Math.max(0, window.scrollY / scrollable));
			for (const bar of progressBars) {
				bar.style.transform = `scaleX(${progress})`;
			}

			if (sections.length) {
				const anchorY = window.innerHeight * 0.22;
				let active = sections[0].target.id;
				for (const { target } of sections) {
					if (target.getBoundingClientRect().top <= anchorY) active = target.id;
				}
				setActive(active);
			}
		};

		const schedule = () => {
			if (!frame) frame = window.requestAnimationFrame(update);
		};

		const handleResize = () => {
			schedule();
			for (const outline of outlines) {
				if (outline.dataset.dragged !== 'true') continue;
				const rect = outline.getBoundingClientRect();
				applyPosition(outline, rect.left, rect.top);
			}
		};

		on(window, 'scroll', schedule, { passive: true });
		on(window, 'resize', handleResize);
		window.__readingAssistCleanup = () => {
			for (const cleanup of cleanups) cleanup();
			if (frame) window.cancelAnimationFrame(frame);
			frame = 0;
		};

		update();
	};

	document.addEventListener('astro:page-load', setupReadingAssist);
	document.addEventListener('DOMContentLoaded', setupReadingAssist);
</script>
