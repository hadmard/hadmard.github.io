---
// 文件说明：该文件渲染站点的语言切换按钮。
// 功能说明：在双语页面之间跳转，并保持当前语种的可见状态。
//
// 结构概览：
//   第一部分：解析组件参数
//   第二部分：输出语言切换 UI
interface Props {
	currentLocale: 'zh-cn' | 'en';
	href: string;
}

const { currentLocale, href } = Astro.props;
---

<a
	href={href}
	class="inline-flex items-center gap-2 rounded-full border border-black/5 bg-white/40 backdrop-blur-md px-3 py-1.5 text-sm text-[#1d1d1f] shadow-[0_2px_8px_rgba(0,0,0,0.04)] transition duration-500 hover:border-black/10 hover:bg-white/80 hover:shadow-[0_4px_16px_rgba(0,0,0,0.06)]"
>
	<span class:list={['rounded-full px-2 py-1 text-[11px] font-medium transition-colors', currentLocale === 'zh-cn' ? 'bg-[#1d1d1f] text-white' : 'text-[#1d1d1f]/60 hover:text-[#1d1d1f]']}>中</span>
	<span class:list={['rounded-full px-2 py-1 text-[11px] font-medium transition-colors', currentLocale === 'en' ? 'bg-[#1d1d1f] text-white' : 'text-[#1d1d1f]/60 hover:text-[#1d1d1f]']}>EN</span>
</a>
