---
import Layout from '../layouts/Layout.astro';
import SiteHeader from './SiteHeader.astro';
import { getCopy } from '../utils/i18n';

const { locale } = Astro.props;
const copy = getCopy(locale);
const { basePath = '', navBasePath = basePath, canonicalPath: canonicalPathOverride, alternatePath: alternatePathOverride } = Astro.props;
const normalizedBasePath = basePath ? `/${basePath.replace(/^\/+|\/+$/g, '')}` : '';
const normalizedNavBasePath = navBasePath ? `/${navBasePath.replace(/^\/+|\/+$/g, '')}` : normalizedBasePath;
const alternatePath = alternatePathOverride ?? (locale === 'zh-cn' ? `${normalizedBasePath}/en/` : `${normalizedBasePath || '/'}`);
const canonicalPath = canonicalPathOverride ?? (locale === 'zh-cn' ? `${normalizedBasePath || '/'}` : `${normalizedBasePath}/en/`);

const hrefFor = (id: string) => locale === 'zh-cn' ? `${normalizedNavBasePath}/${id}/` : `${normalizedNavBasePath}/en/${id}/`;
const cards = copy.nav.map((item) => {
	return {
		...item,
		href: hrefFor(item.id),
	};
});
const heroTitle = locale === 'zh-cn' ? '把当下，留给以后看。' : 'Keep now for later.';
const heroIntro = locale === 'zh-cn'
	? '投资、思考、学习、作息和救赎路上的片段，整理成一个安静、清晰、会呼吸的个人档案。'
	: 'Investment notes, thoughts, study logs, routines, and recovery notes collected into a calm personal archive.';
const heroKicker = locale === 'zh-cn' ? '个人档案 · 记录空间' : 'Personal Archive';

---

<Layout
	title={copy.seo.title}
	description={copy.seo.description}
	lang={locale}
	canonicalPath={canonicalPath}
	alternatePath={alternatePath}
>
	<main class="site-shell blog-shell home-shell">
		<SiteHeader locale={locale} alternatePath={alternatePath} basePath={normalizedNavBasePath} />

		<section class="blog-hero home-archive-hero" data-reveal>
			<div class="home-hero-copy">
				<p class="home-hero-kicker">{heroKicker}</p>
				<h1 class="home-hero-title">{heroTitle}</h1>
				<p class="home-hero-intro">{heroIntro}</p>
			</div>
			<div class="home-hero-stage" aria-hidden="true">
				<span class="home-stage-orbit"></span>
				<span class="home-stage-path"></span>
				<span class="home-stage-strip home-stage-strip-blue"></span>
				<span class="home-stage-strip home-stage-strip-amber"></span>
				<span class="home-stage-panel">
					<span class="home-stage-sheen"></span>
					<span class="home-stage-tile home-stage-tile-investments">
						<svg viewBox="0 0 32 32" role="presentation">
							<path d="M5.5 23.5h21" />
							<path d="m8 20 6.1-6.2 4.1 3.7L25 9.5" />
							<path d="M20.2 9.5H25v4.8" />
						</svg>
					</span>
					<span class="home-stage-tile home-stage-tile-thinking">
						<svg viewBox="0 0 32 32" role="presentation">
							<path d="M9.5 22.5 8 27l4.5-1.5L24.7 13.3a3 3 0 0 0-4.2-4.2L8.3 21.3Z" />
							<path d="m18.6 11 4.4 4.4" />
						</svg>
					</span>
					<span class="home-stage-tile home-stage-tile-study">
						<svg viewBox="0 0 32 32" role="presentation">
							<path d="M9 5.5v5M23 5.5v5M6.5 12.5h19" />
							<path d="M8.2 7.8h15.6a2.8 2.8 0 0 1 2.8 2.8v13.2a2.8 2.8 0 0 1-2.8 2.8H8.2a2.8 2.8 0 0 1-2.8-2.8V10.6a2.8 2.8 0 0 1 2.8-2.8Z" />
							<path d="m10.5 19 3.2 3.2 7.8-8" />
						</svg>
					</span>
					<span class="home-stage-tile home-stage-tile-health">
						<svg viewBox="0 0 32 32" role="presentation">
							<path d="M16 27s-8.5-5.2-8.5-13.1A5.6 5.6 0 0 1 16 9.2a5.6 5.6 0 0 1 8.5 4.7C24.5 21.8 16 27 16 27Z" />
							<path d="M10.2 16.4h3.1l1.8-5 2.4 8.2 1.6-3.2h4.2" />
						</svg>
					</span>
				</span>
				<span class="home-stage-note">
					<svg viewBox="0 0 32 32" role="presentation">
						<path d="M6 24c4.4-9.6 10.2-15 20-17.5" />
						<path d="m19 5.6 7 0.9-2.9 6.3" />
						<path d="M7.2 24.4c5.6 1.8 11.6.7 17.4-2.9" />
					</svg>
				</span>
				<span class="home-stage-rail">
					<span></span>
					<span></span>
					<span></span>
					<span></span>
				</span>
			</div>
		</section>

		<section class="blog-list" aria-label={locale === 'zh-cn' ? '博客入口' : 'Blog entries'} data-reveal>
			{cards.map((card) => (
				<a class={`blog-card module-card-${card.id}`} href={card.href}>
					<i class={`module-glyph module-glyph-${card.id}`} aria-hidden="true">
						{card.id === 'investments' ? (
							<svg viewBox="0 0 32 32" role="presentation">
								<path d="M5 24.5h22M7 22l5.8-6 4.6 3.8L25 9.5" />
								<path d="M20.2 9.5H25v4.8" />
							</svg>
						) : card.id === 'study-calendar' ? (
							<svg viewBox="0 0 32 32" role="presentation">
								<path d="M9 5.5v5M23 5.5v5M6.5 12.5h19M8.2 7.8h15.6a2.8 2.8 0 0 1 2.8 2.8v13.2a2.8 2.8 0 0 1-2.8 2.8H8.2a2.8 2.8 0 0 1-2.8-2.8V10.6a2.8 2.8 0 0 1 2.8-2.8Z" />
								<path d="m10.5 19 3.2 3.2 7.8-8" />
							</svg>
						) : card.id === 'health-routine' ? (
							<svg viewBox="0 0 32 32" role="presentation">
								<path d="M16 27s-8.5-5.2-8.5-13.1A5.6 5.6 0 0 1 16 9.2a5.6 5.6 0 0 1 8.5 4.7C24.5 21.8 16 27 16 27Z" />
								<path d="M10.2 16.4h3.1l1.8-5 2.4 8.2 1.6-3.2h4.2" />
							</svg>
						) : card.id === 'redemption-road' ? (
							<svg viewBox="0 0 32 32" role="presentation">
								<path d="M6 24c4.4-9.6 10.2-15 20-17.5" />
								<path d="m19 5.6 7 0.9-2.9 6.3" />
								<path d="M7.2 24.4c5.6 1.8 11.6.7 17.4-2.9" />
							</svg>
						) : (
							<svg viewBox="0 0 32 32" role="presentation">
								<path d="M9.5 22.5 8 27l4.5-1.5L24.7 13.3a3 3 0 0 0-4.2-4.2L8.3 21.3Z" />
								<path d="m18.6 11 4.4 4.4M15.2 25.5h9.8" />
							</svg>
						)}
					</i>
					<span class="card-arrow" aria-hidden="true"></span>
					<span class="module-card-rail" aria-hidden="true"></span>
					<strong>{card.label}</strong>
				</a>
			))}
		</section>
	</main>
</Layout>
