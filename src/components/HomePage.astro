---
import Layout from '../layouts/Layout.astro';
import SiteHeader from './SiteHeader.astro';
import { getCopy } from '../utils/i18n';

const { locale } = Astro.props;
const copy = getCopy(locale);
const { basePath = '', navBasePath = basePath, canonicalPath: canonicalPathOverride, alternatePath: alternatePathOverride } = Astro.props;
const normalizedBasePath = basePath ? `/${basePath.replace(/^\/+|\/+$/g, '')}` : '';
const normalizedNavBasePath = navBasePath ? `/${navBasePath.replace(/^\/+|\/+$/g, '')}` : normalizedBasePath;
const alternatePath = alternatePathOverride ?? (locale === 'zh-cn' ? `${normalizedBasePath}/en/` : `${normalizedBasePath || '/'}`);
const canonicalPath = canonicalPathOverride ?? (locale === 'zh-cn' ? `${normalizedBasePath || '/'}` : `${normalizedBasePath}/en/`);
---

<Layout
    title={copy.seo.title}
    description={copy.seo.description}
    lang={locale}
    canonicalPath={canonicalPath}
    alternatePath={alternatePath}
>
    <main class="site-shell">
        <SiteHeader locale={locale} alternatePath={alternatePath} basePath={normalizedNavBasePath} />

        <section class="hero-particle-wrap mt-6 sm:mt-10" data-reveal>
            <canvas id={`particle-canvas-${locale}`} class="hero-particle-canvas" aria-hidden="true"></canvas>
            <div class="hero-particle-panel mx-auto flex min-h-[500px] max-w-5xl flex-col items-center justify-center px-6 py-20 text-center sm:min-h-[640px] sm:px-10">
                <p class="soft-label mb-8 shadow-sm bg-white/60 backdrop-blur-md border-white/80">{copy.hero?.badge || 'YFCCCC.GITHUB.IO'}</p>
                <h1 class="hero-title max-w-4xl text-[#1d1d1f]">
                    {copy.hero?.title}
                </h1>
                <p class="hero-subtitle mt-6 max-w-3xl text-[#1d1d1f]/70">
                    {copy.hero?.description}
                </p>
                <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
                    <span class="inline-flex items-center rounded-full bg-[#1d1d1f] px-6 py-3 text-[15px] font-medium text-white shadow-md transition-transform hover:scale-105 duration-300">
                        {copy.hero?.primaryCta || (locale === 'zh-cn' ? '请使用右上角导航' : 'Use top-right navigation')}
                    </span>
                    <span class="inline-flex items-center rounded-full bg-white/50 backdrop-blur-md border border-white/60 px-6 py-3 text-[15px] font-medium text-[#1d1d1f] shadow-sm transition-transform hover:scale-105 duration-300">
                        {copy.hero?.secondaryCta || (locale === 'zh-cn' ? '仅通过栏目进入子页面' : 'Open subpages from top navigation only')}
                    </span>
                </div>
            </div>
        </section>
    </main>
</Layout>

<script is:inline>
    (() => {
        const canvas = document.querySelector('.hero-particle-canvas');
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        if (!ctx) return;

        // Apple 液态玻璃调色板
        const colors = [
            'rgba(0, 113, 227, 0.4)',   // 苹果蓝
            'rgba(88, 86, 214, 0.3)',   // 紫色
            'rgba(255, 45, 85, 0.25)',  // 粉色
            'rgba(90, 200, 250, 0.4)',  // 青色
            'rgba(255, 149, 0, 0.2)'    // 橙色
        ];

        const orbs = [];
        let width = 0;
        let height = 0;
        let raf = 0;

        const init = () => {
            const rect = canvas.getBoundingClientRect();
            width = rect.width;
            height = rect.height;
            canvas.width = Math.floor(width * window.devicePixelRatio);
            canvas.height = Math.floor(height * window.devicePixelRatio);
            ctx.setTransform(window.devicePixelRatio, 0, 0, window.devicePixelRatio, 0, 0);

            orbs.length = 0;
            const count = width < 640 ? 4 : 6;
            for (let i = 0; i < count; i += 1) {
                const radius = (Math.random() * 150) + 150; // 大型球体 150-300px
                orbs.push({
                    x: Math.random() * width,
                    y: Math.random() * height,
                    vx: (Math.random() - 0.5) * 0.8,
                    vy: (Math.random() - 0.5) * 0.8,
                    r: radius,
                    color: colors[i % colors.length]
                });
            }
        };

        const draw = () => {
            ctx.clearRect(0, 0, width, height);

            for (const p of orbs) {
                p.x += p.vx;
                p.y += p.vy;

                // 柔和反弹
                if (p.x < -p.r || p.x > width + p.r) p.vx *= -1;
                if (p.y < -p.r || p.y > height + p.r) p.vy *= -1;

                // 绘制球体
                ctx.beginPath();
                ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
                ctx.fillStyle = p.color;
                ctx.fill();
            }

            raf = requestAnimationFrame(draw);
        };

        init();
        draw();
        window.addEventListener('resize', init);
        window.addEventListener('beforeunload', () => cancelAnimationFrame(raf));
    })();
</script>
