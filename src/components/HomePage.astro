---
import Layout from '../layouts/Layout.astro';
import SiteHeader from './SiteHeader.astro';
import { getCopy } from '../utils/i18n';

const { locale } = Astro.props;
const copy = getCopy(locale);
const { basePath = '', navBasePath = basePath, canonicalPath: canonicalPathOverride, alternatePath: alternatePathOverride } = Astro.props;
const normalizedBasePath = basePath ? `/${basePath.replace(/^\/+|\/+$/g, '')}` : '';
const normalizedNavBasePath = navBasePath ? `/${navBasePath.replace(/^\/+|\/+$/g, '')}` : normalizedBasePath;
const alternatePath = alternatePathOverride ?? (locale === 'zh-cn' ? `${normalizedBasePath}/en/` : `${normalizedBasePath || '/'}`);
const canonicalPath = canonicalPathOverride ?? (locale === 'zh-cn' ? `${normalizedBasePath || '/'}` : `${normalizedBasePath}/en/`);

const hrefFor = (id: string) => locale === 'zh-cn' ? `${normalizedNavBasePath}/${id}/` : `${normalizedNavBasePath}/en/${id}/`;
const studyCalendarLabel = copy.nav.find((item) => item.id === 'study-calendar')?.label ?? (locale === 'zh-cn' ? '学习日历' : 'Study Calendar');
const cards = copy.nav.map((item) => {
	const metric = copy.hero.metrics.find((entry) => entry.label === item.label);
	return {
		...item,
		href: hrefFor(item.id),
		value: metric?.value ?? item.label,
		note: metric?.note ?? '',
	};
});

---

<Layout
	title={copy.seo.title}
	description={copy.seo.description}
	lang={locale}
	canonicalPath={canonicalPath}
	alternatePath={alternatePath}
>
	<main class="site-shell blog-shell">
		<SiteHeader locale={locale} alternatePath={alternatePath} basePath={normalizedNavBasePath} />

		<section class="blog-hero" data-reveal>
			<p class="soft-label">{copy.hero.badge}</p>
			<h1>{copy.hero.title}</h1>
			<p>{copy.hero.description}</p>
			<div class="blog-actions">
				<a href={hrefFor('investments')} class="apple-button apple-button-dark apple-button-icon">
					<span class="button-glyph" aria-hidden="true">
						<svg viewBox="0 0 24 24" role="presentation">
							<path d="M4 18.5h16M5.8 16l4.4-4.6 3.4 2.8 5.2-7.1" />
							<path d="M15.6 7.1h3.2v3.2" />
						</svg>
					</span>
					{copy.hero.primaryCta}
				</a>
				<a href={hrefFor('thinking')} class="apple-button apple-button-light apple-button-icon">
					<span class="button-glyph" aria-hidden="true">
						<svg viewBox="0 0 24 24" role="presentation">
							<path d="M7.2 18.4 6 22l3.6-1.2 9.6-9.6a2.4 2.4 0 0 0-3.4-3.4L6.2 17.4Z" />
							<path d="m14.4 9.2 3.4 3.4M11.6 20h7.8" />
						</svg>
					</span>
					{copy.hero.secondaryCta}
				</a>
				<a href={hrefFor('study-calendar')} class="apple-button apple-button-light apple-button-icon">
					<span class="button-glyph" aria-hidden="true">
						<svg viewBox="0 0 24 24" role="presentation">
							<path d="M7.5 4.5v3.4M16.5 4.5v3.4M5.2 9.2h13.6M6.7 6.3h10.6a2.4 2.4 0 0 1 2.4 2.4v9.1a2.4 2.4 0 0 1-2.4 2.4H6.7a2.4 2.4 0 0 1-2.4-2.4V8.7a2.4 2.4 0 0 1 2.4-2.4Z" />
							<path d="m8.2 15 2.3 2.2 5.3-5.4" />
						</svg>
					</span>
					{studyCalendarLabel}
				</a>
			</div>
			<div class="journal-stage" aria-hidden="true">
				<span class="journal-halo"></span>
				<div class="journal-sheet journal-sheet-main">
					<div class="sheet-dots">
						<span></span>
						<span></span>
						<span></span>
					</div>
					<div class="sheet-title-line"></div>
					<div class="sheet-rule sheet-rule-wide"></div>
					<div class="sheet-rule"></div>
					<div class="sheet-rule sheet-rule-short"></div>
				</div>
				<div class="journal-sheet journal-sheet-market">
					<div class="market-bars">
						<span></span>
						<span></span>
						<span></span>
						<span></span>
						<span></span>
					</div>
					<div class="market-line">
						<span></span>
						<span></span>
						<span></span>
					</div>
				</div>
				<div class="journal-sheet journal-sheet-thought">
					<span class="thought-mark"></span>
					<span class="thought-line"></span>
					<span class="thought-line thought-line-short"></span>
				</div>
				<span class="journal-accent journal-accent-blue"></span>
				<span class="journal-accent journal-accent-graphite"></span>
				<span class="journal-accent journal-accent-paper"></span>
			</div>
		</section>

		<section class="blog-list" aria-label={locale === 'zh-cn' ? '博客入口' : 'Blog entries'} data-reveal>
			{cards.map((card) => (
				<a class="blog-card" href={card.href}>
					<i class={`module-glyph module-glyph-${card.id}`} aria-hidden="true">
						{card.id === 'investments' ? (
							<svg viewBox="0 0 32 32" role="presentation">
								<path d="M5 24.5h22M7 22l5.8-6 4.6 3.8L25 9.5" />
								<path d="M20.2 9.5H25v4.8" />
							</svg>
						) : card.id === 'study-calendar' ? (
							<svg viewBox="0 0 32 32" role="presentation">
								<path d="M9 5.5v5M23 5.5v5M6.5 12.5h19M8.2 7.8h15.6a2.8 2.8 0 0 1 2.8 2.8v13.2a2.8 2.8 0 0 1-2.8 2.8H8.2a2.8 2.8 0 0 1-2.8-2.8V10.6a2.8 2.8 0 0 1 2.8-2.8Z" />
								<path d="m10.5 19 3.2 3.2 7.8-8" />
							</svg>
						) : (
							<svg viewBox="0 0 32 32" role="presentation">
								<path d="M9.5 22.5 8 27l4.5-1.5L24.7 13.3a3 3 0 0 0-4.2-4.2L8.3 21.3Z" />
								<path d="m18.6 11 4.4 4.4M15.2 25.5h9.8" />
							</svg>
						)}
					</i>
					<span class="card-arrow" aria-hidden="true"></span>
					<span>{card.label}</span>
					<strong>{card.value}</strong>
					{card.note && <p>{card.note}</p>}
				</a>
			))}
		</section>
	</main>
</Layout>
