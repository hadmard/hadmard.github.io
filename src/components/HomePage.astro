---
import Layout from '../layouts/Layout.astro';
import SiteHeader from './SiteHeader.astro';
import { getCopy } from '../utils/i18n';

const { locale } = Astro.props;
const copy = getCopy(locale);
const { basePath = '', navBasePath = basePath, canonicalPath: canonicalPathOverride, alternatePath: alternatePathOverride } = Astro.props;
const normalizedBasePath = basePath ? `/${basePath.replace(/^\/+|\/+$/g, '')}` : '';
const normalizedNavBasePath = navBasePath ? `/${navBasePath.replace(/^\/+|\/+$/g, '')}` : normalizedBasePath;
const alternatePath = alternatePathOverride ?? (locale === 'zh-cn' ? `${normalizedBasePath}/en/` : `${normalizedBasePath || '/'}`);
const canonicalPath = canonicalPathOverride ?? (locale === 'zh-cn' ? `${normalizedBasePath || '/'}` : `${normalizedBasePath}/en/`);

const hrefFor = (id: string) => locale === 'zh-cn' ? `${normalizedNavBasePath}/${id}/` : `${normalizedNavBasePath}/en/${id}/`;
const cards = copy.nav.map((item) => {
	return {
		...item,
		href: hrefFor(item.id),
	};
});

---

<Layout
	title={copy.seo.title}
	description={copy.seo.description}
	lang={locale}
	canonicalPath={canonicalPath}
	alternatePath={alternatePath}
>
	<main class="site-shell blog-shell">
		<SiteHeader locale={locale} alternatePath={alternatePath} basePath={normalizedNavBasePath} />

		<section class="blog-hero" data-reveal>
			<div class="home-hero-copy">
				<h1 class="brand-wordmark">{copy.hero.title}</h1>
			</div>
			<div class="home-hero-mark" aria-hidden="true">
				<span class="home-mark-ribbon home-mark-ribbon-one"></span>
				<span class="home-mark-ribbon home-mark-ribbon-two"></span>
				<span class="home-mark-orbit"></span>
				<span class="home-mark-core">
					<span>
						<svg viewBox="0 0 32 32" role="presentation">
							<path d="M6 23h20" />
							<path d="m8.5 20 6.1-6.2 4.2 3.7L25 9.5" />
							<path d="M20.5 9.5H25v4.5" />
						</svg>
					</span>
					<span>
						<svg viewBox="0 0 32 32" role="presentation">
							<path d="M9.2 22.4 8 26l3.6-1.2 12-12a3 3 0 0 0-4.2-4.2l-12 12Z" />
							<path d="m18.1 10 4.1 4.1" />
						</svg>
					</span>
					<span>
						<svg viewBox="0 0 32 32" role="presentation">
							<path d="M9.5 5.8v4.5M22.5 5.8v4.5M6.8 12h18.4" />
							<path d="M8.8 8.2h14.4a3 3 0 0 1 3 3v12a3 3 0 0 1-3 3H8.8a3 3 0 0 1-3-3v-12a3 3 0 0 1 3-3Z" />
							<path d="m10.5 18.6 3.3 3.2 7.6-8" />
						</svg>
					</span>
					<span>
						<svg viewBox="0 0 32 32" role="presentation">
							<path d="M16 26.5s-8.5-5.1-8.5-12.7A5.5 5.5 0 0 1 16 9.2a5.5 5.5 0 0 1 8.5 4.6c0 7.6-8.5 12.7-8.5 12.7Z" />
							<path d="M10.4 16.2h3.1l1.6-4.6 2.4 8 1.5-3.4h2.8" />
						</svg>
					</span>
				</span>
			</div>
		</section>

		<section class="blog-list" aria-label={locale === 'zh-cn' ? '博客入口' : 'Blog entries'} data-reveal>
			{cards.map((card) => (
				<a class="blog-card" href={card.href}>
					<i class={`module-glyph module-glyph-${card.id}`} aria-hidden="true">
						{card.id === 'investments' ? (
							<svg viewBox="0 0 32 32" role="presentation">
								<path d="M5 24.5h22M7 22l5.8-6 4.6 3.8L25 9.5" />
								<path d="M20.2 9.5H25v4.8" />
							</svg>
						) : card.id === 'study-calendar' ? (
							<svg viewBox="0 0 32 32" role="presentation">
								<path d="M9 5.5v5M23 5.5v5M6.5 12.5h19M8.2 7.8h15.6a2.8 2.8 0 0 1 2.8 2.8v13.2a2.8 2.8 0 0 1-2.8 2.8H8.2a2.8 2.8 0 0 1-2.8-2.8V10.6a2.8 2.8 0 0 1 2.8-2.8Z" />
								<path d="m10.5 19 3.2 3.2 7.8-8" />
							</svg>
						) : card.id === 'health-routine' ? (
							<svg viewBox="0 0 32 32" role="presentation">
								<path d="M16 27s-8.5-5.2-8.5-13.1A5.6 5.6 0 0 1 16 9.2a5.6 5.6 0 0 1 8.5 4.7C24.5 21.8 16 27 16 27Z" />
								<path d="M10.2 16.4h3.1l1.8-5 2.4 8.2 1.6-3.2h4.2" />
							</svg>
						) : card.id === 'redemption-road' ? (
							<svg viewBox="0 0 32 32" role="presentation">
								<path d="M6 24c4.4-9.6 10.2-15 20-17.5" />
								<path d="m19 5.6 7 0.9-2.9 6.3" />
								<path d="M7.2 24.4c5.6 1.8 11.6.7 17.4-2.9" />
							</svg>
						) : (
							<svg viewBox="0 0 32 32" role="presentation">
								<path d="M9.5 22.5 8 27l4.5-1.5L24.7 13.3a3 3 0 0 0-4.2-4.2L8.3 21.3Z" />
								<path d="m18.6 11 4.4 4.4M15.2 25.5h9.8" />
							</svg>
						)}
					</i>
					<span class="card-arrow" aria-hidden="true"></span>
					<strong>{card.label}</strong>
				</a>
			))}
		</section>
	</main>
</Layout>
