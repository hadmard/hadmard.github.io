---
// 文件说明：该组件渲染“学习日历”页面。
// 功能说明：读取 CC98 学习日记同步结果，并以时间线方式展示楼主学习记录。

import type { Locale } from '../data/site';

import Layout from '../layouts/Layout.astro';
import SiteHeader from './SiteHeader.astro';
import ReadingAssist from './ReadingAssist.astro';
import { getCopy } from '../utils/i18n';
import { loadCc98Dataset } from '../utils/cc98';
import { createFloorOutline } from '../utils/reading';

const { locale, canonicalPath, alternatePath } = Astro.props as {
	locale: Locale;
	canonicalPath: string;
	alternatePath: string;
};

const copy = getCopy(locale);
const { config, summary, visibleRecords } = await loadCc98Dataset('studyCalendar');

const localeTag = locale === 'zh-cn' ? 'zh-CN' : 'en-US';
const formatDate = (value: string) => new Date(value).toLocaleDateString(localeTag, {
	month: '2-digit',
	day: '2-digit',
});
const formatTime = (value: string) => new Date(value).toLocaleTimeString(localeTag, {
	hour: '2-digit',
	minute: '2-digit',
	hour12: false,
});
const formatFullDate = (value: string) => new Date(value).toLocaleString(localeTag, {
	year: 'numeric',
	month: '2-digit',
	day: '2-digit',
	hour: '2-digit',
	minute: '2-digit',
	hour12: false,
});

const crawledAtText = summary?.crawledAt ? formatFullDate(summary.crawledAt) : null;
const outline = createFloorOutline(visibleRecords, locale);
const outlineLabel = locale === 'zh-cn' ? '楼层目录' : 'Floors';
const sourceUrl = summary?.sourceUrl ?? config.sourceUrl;
---

<Layout
	title={`${copy.studyCalendar.title} | ${copy.brand.name}`}
	description={copy.seo.description}
	lang={locale}
	canonicalPath={canonicalPath}
	alternatePath={alternatePath}
>
	<main class="site-shell reading-shell">
		<SiteHeader locale={locale} alternatePath={alternatePath} />

		<section class="reading-hero study-hero" data-reveal>
			<p class="soft-label">{copy.studyCalendar.kicker}</p>
			<h1>{copy.studyCalendar.title}</h1>
			<p>{copy.studyCalendar.intro}</p>
			<div class="hero-material-stack study-symbol-stack" aria-hidden="true">
				<span class="hero-symbol hero-symbol-primary">
					<svg viewBox="0 0 28 28" role="presentation">
						<path d="M8 4.8v4.4M20 4.8v4.4M5.8 10.8h16.4M7.2 6.8h13.6a2.4 2.4 0 0 1 2.4 2.4v12.2a2.4 2.4 0 0 1-2.4 2.4H7.2a2.4 2.4 0 0 1-2.4-2.4V9.2a2.4 2.4 0 0 1 2.4-2.4Z" />
						<path d="m9.4 17.2 2.5 2.5 6-6" />
					</svg>
				</span>
				<span class="hero-symbol">
					<svg viewBox="0 0 28 28" role="presentation">
						<path d="M7 7.2h14M7 13.8h14M7 20.4h8.4" />
					</svg>
				</span>
				<span class="hero-symbol">{visibleRecords.length}</span>
				<span class="hero-slab hero-slab-a"></span>
				<span class="hero-slab hero-slab-b"></span>
			</div>
			<div class="reading-meta">
				{summary?.topic?.title && <span>{summary.topic.title}</span>}
				<span>{visibleRecords.length} {copy.studyCalendar.entryLabel}</span>
				{sourceUrl && (
					<a href={sourceUrl} target="_blank" rel="noopener noreferrer">{copy.studyCalendar.sourceLabel}</a>
				)}
				{crawledAtText && <span>{crawledAtText}</span>}
			</div>
		</section>

		<ReadingAssist outline={outline} label={outlineLabel} />

		{visibleRecords.length > 0 ? (
			<section class="study-timeline" aria-label={copy.studyCalendar.title}>
				{visibleRecords.map((record, index) => (
					<article id={`floor-${record.floor}`} class="study-entry" data-reveal style={`--timeline-index: ${index}`}>
						<div class="study-date-chip">
							<span>{formatDate(record.time)}</span>
							<time>{formatTime(record.time)}</time>
						</div>
						<div class="timeline-node" aria-hidden="true">
							<span></span>
						</div>
						<div class="study-entry-card">
							<span class="study-card-glyph" aria-hidden="true">
								<svg viewBox="0 0 32 32" role="presentation">
									<path d="M9 6.5h10.2a3.8 3.8 0 0 1 3.8 3.8v15.2H11.2A3.2 3.2 0 0 1 8 22.3V7.5a1 1 0 0 1 1-1Z" />
									<path d="M11.2 25.5a3.2 3.2 0 0 1 0-6.4H23M12 11h7M12 15h5" />
								</svg>
							</span>
							<div class="raw-entry-meta study-entry-meta">
								<span class="meta-chip meta-chip-floor">
									<svg viewBox="0 0 20 20" role="presentation">
										<path d="M6 4.5h7.8a1.7 1.7 0 0 1 1.7 1.7v9.3H7.2A2.2 2.2 0 0 1 5 13.3V5.5a1 1 0 0 1 1-1Z" />
										<path d="M7.2 15.5a2.2 2.2 0 0 1 0-4.4h8.3M8 7.4h4.8" />
									</svg>
									#{record.floor}
								</span>
								<span class="meta-chip meta-chip-user">
									<svg viewBox="0 0 20 20" role="presentation">
										<path d="M10 10.1a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4Z" />
										<path d="M4.4 16.3a5.9 5.9 0 0 1 11.2 0" />
									</svg>
									{record.userName}
								</span>
							</div>
							<div class="raw-entry-body study-entry-body markdown-body" set:html={record.renderedContent} />
						</div>
					</article>
				))}
			</section>
		) : (
			<section class="raw-empty" data-reveal>
				<h2>{copy.studyCalendar.emptyTitle}</h2>
				<p>{copy.studyCalendar.emptyDescription}</p>
			</section>
		)}
	</main>
</Layout>
