---
// 文件说明：该文件负责渲染思考文章详情页。
// 功能说明：统一输出文章头图区域、正文排版、关联文章和评论入口。
//
// 结构概览：
//   第一部分：导入依赖与解析参数
//   第二部分：准备页面文案与路径
//   第三部分：输出文章详情结构
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../data/site';

import Layout from '../layouts/Layout.astro';
import { getCopy, getThoughtSlug } from '../utils/i18n';
import Comments from './Comments.astro';
import LocaleSwitch from './LocaleSwitch.astro';

const { locale, post, Content, related, alternateHref, canonicalPath, basePath = '/old' } = Astro.props as {
	locale: Locale;
	post: CollectionEntry<'thoughts'>;
	Content: any;
	related: CollectionEntry<'thoughts'>[];
	alternateHref: string;
	canonicalPath: string;
	basePath?: string;
};
const copy = getCopy(locale);
const normalizedBasePath = basePath ? `/${basePath.replace(/^\/+|\/+$/g, '')}` : '';
const thinkingHref = locale === 'zh-cn'
	? `${normalizedBasePath}/thinking/`
	: `${normalizedBasePath}/en/thinking/`;
const relatedHref = (entry: CollectionEntry<'thoughts'>) => locale === 'zh-cn'
	? `${normalizedBasePath}/thinking/${getThoughtSlug(entry)}/`
	: `${normalizedBasePath}/en/thinking/${getThoughtSlug(entry)}/`;
---

<Layout
	title={`${post.data.title} | ${copy.brand.name}`}
	description={post.data.excerpt}
	lang={locale}
	canonicalPath={canonicalPath}
	alternatePath={alternateHref}
>
	<main class="site-shell reading-shell">
		<header class="glass-topbar flex flex-wrap items-center justify-between gap-4">
			<div class="flex min-w-0 items-center gap-3 text-sm text-[#1d1d1f]/62">
				<a class="nav-link active" href={thinkingHref}>{copy.post.backLabel}</a>
				<span class="hidden sm:inline">/</span>
				<span class="truncate">{post.data.title}</span>
			</div>
			<LocaleSwitch currentLocale={locale} href={alternateHref} />
		</header>

		<section class="article-hero" data-reveal>
			<div class="max-w-4xl">
				<p class="section-kicker">{post.data.publishedAt.toLocaleDateString(locale === 'zh-cn' ? 'zh-CN' : 'en-US')}</p>
				<h1>{post.data.title}</h1>
				<p>{post.data.excerpt}</p>
				<div class="article-meta">
					<span class="soft-label">{post.data.readingTime}</span>
					{post.data.tags.map((tag) => <span class="signal-pill">{tag}</span>)}
				</div>
			</div>
		</section>

		<section class="article-layout">
			<article class="panel-strong article-body">
				<div class="prose-thought">
					<Content />
				</div>
			</article>
			<aside class="space-y-6">
				<div class="side-panel">
					<p class="section-kicker">{copy.post.otherLocaleLabel}</p>
					<p>
						{locale === 'zh-cn'
							? '同一篇的英文版本。'
							: 'Chinese version of this note.'}
					</p>
					<a class="apple-link mt-5" href={alternateHref}>
						{copy.post.otherLocaleLabel}
					</a>
				</div>
				{related.length > 0 && (
					<div class="side-panel">
						<p class="section-kicker">{copy.post.relatedTitle}</p>
						<div class="mt-4 space-y-4">
							{
								related.map((entry) => (
									<a class="related-card block p-4" href={relatedHref(entry)}>
										<strong>{entry.data.title}</strong>
										<p>{entry.data.excerpt}</p>
									</a>
								))
							}
						</div>
					</div>
				)}
			</aside>
		</section>

		<Comments title={copy.thinking.commentTitle} note={copy.thinking.commentNote} />
	</main>
</Layout>
